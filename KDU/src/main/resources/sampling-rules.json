{
  "version": 2,
  "rules": [
    {
      "description": "API endpoints",
      "host": "*",
      "http_method": "*",
      "url_path": "/api/*",
      "fixed_target": 1,
      "rate": 0.1
    },
    {
      "description": "GraphQL requests",
      "host": "*",
      "http_method": "POST",
      "url_path": "/graphql*",
      "fixed_target": 1,
      "rate": 0.1
    }
  ],
  "default": {
    "fixed_target": 1,
    "rate": 0.01
  }
}